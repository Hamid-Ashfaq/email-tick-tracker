# Copy to .env and fill in real values.

# SQLite for local dev; Production: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./tracker.db

# Use a long random string in production.
SECRET_KEY=replace-with-a-long-random-string

# Shared key the extension sends as X-Api-Key. Must match the extension config.
API_KEY=replace-with-a-random-api-key

# Used to build pixel URLs. Set to your deployed HTTPS URL in production.
BASE_URL=http://localhost:8000

# Dedup window for open events (seconds).
OPEN_DEDUP_WINDOW=30
